@startuml erd
skinparam monochrome true
skinparam shadowing false
hide circle
skinparam linetype ortho
title Database (ERD), as built in Lab 07 (SQLite)

entity "users" as users {
  *id : INTEGER <<PK>>
  --
  *email : TEXT <<unique>>
  *password_hash : TEXT
  *created_at : TEXT (ISO time)
  *role : USER / ADMIN  (Lab 07)
  *disabled : 0 / 1  (Lab 07)
  *token_version : INTEGER  (Lab 07)
}

entity "balances" as balances {
  *user_id : INTEGER <<PK, FK>>
  *currency : TEXT(3) <<PK>>
  --
  *amount_minor : INTEGER
  note: 1/100 units, CHECK >= 0
}

entity "orders" as orders {
  *request_id : TEXT (UUID) <<PK>>
  --
  *user_id : INTEGER <<FK>>
  *side : BUY / SELL
  *currency : TEXT(3)
  *amount_minor : INTEGER
  *seen_rate_e4 : INTEGER
  rate_used_e4 : INTEGER
  pln_minor : INTEGER
  *status : CONFIRMED / REJECTED
  reason : TEXT
  *response_json : TEXT
  *created_at : TEXT (ISO time)
}

entity "rates" as rates {
  *currency : TEXT(3) <<PK>>
  *effective_date : TEXT (date) <<PK>>
  --
  *mid_e4 : INTEGER
  *fetched_at : TEXT (ISO time)
}

entity "admin_actions  (Lab 07)" as admin_actions {
  *id : INTEGER <<PK>>
  --
  *admin_id : INTEGER <<FK>>
  *action : DISABLE_USER / ENABLE_USER / SET_RATE
  *target : TEXT
  detail : TEXT
  *created_at : TEXT (ISO time)
}

users ||--o{ balances
users ||--o{ orders
users ||--o{ admin_actions : performed by
@enduml
