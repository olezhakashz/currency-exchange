@startuml use-cases
left to right direction
skinparam monochrome true
skinparam shadowing false
title Use cases, as built (Lab 07)

actor Visitor
actor User
actor Administrator as Admin
actor "NBP API" as NBP <<external>>
User -|> Visitor
Admin -|> User

rectangle "Currency Exchange" {
  usecase "Register" as REG
  usecase "Log in" as LOGIN
  usecase "See current rates\n(public, read-only)" as UC2
  usecase "Log out" as LOGOUT
  usecase "See own account\nand orders" as ACC
  usecase "See wallet" as UC5
  usecase "Buy / sell currency" as UC7
  usecase "Check order status" as UC10
  usecase "List users,\nsee any wallet" as ADM1
  usecase "Disable / enable\nan account" as ADM2
  usecase "Correct a rate" as ADM3
  usecase "Identify caller\n(token)" as AUTH
  usecase "Check permission\n(own data / ADMIN)" as PERM
  usecase "Get rates from NBP" as UC11
}

Visitor --> REG
Visitor --> LOGIN
Visitor --> UC2
User --> LOGOUT
User --> ACC
User --> UC5
User --> UC7
Admin --> ADM1
Admin --> ADM2
Admin --> ADM3

ACC ..> AUTH : <<include>>
UC5 ..> AUTH : <<include>>
UC7 ..> AUTH : <<include>>
LOGOUT ..> AUTH : <<include>>
ADM1 ..> PERM : <<include>>
ADM2 ..> PERM : <<include>>
ADM3 ..> PERM : <<include>>
ACC ..> PERM : <<include>>
PERM ..> AUTH : <<include>>
UC10 ..> UC7 : <<extend>>
UC2 ..> UC11 : <<include>>
UC11 --> NBP
@enduml
