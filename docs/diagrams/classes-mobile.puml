@startuml classes-mobile
skinparam monochrome true
skinparam shadowing false
hide empty members
title Mobile app, as built (Lab 07)

class CurrencyApp {
  shows LoginScreen or HomeScreen
  from Session.signedIn
}
class LoginScreen {
  log in / create account
  shows why the last session ended
}
class HomeScreen {
  tabs: Rates, Wallet, Account
  + Admin (only if role ADMIN)
  OfflineBanner while unreachable
}
class RatesScreen
class WalletScreen {
  live balances, or last confirmed
  balances with their time when offline
}
class OrderScreen {
  POST /orders, GET /orders/{id}
}
class AccountScreen {
  GET /orders, log out
}
class AdminScreen {
  GET /admin/users, disable / enable
}
class ApiClient {
  -token
  -timeout = 10s
  +login() / register() / logout()
  +getMe() / getOrders()
  +getRates() / getWallet()
  +postOrder() / getOrderStatus()
  +adminUsers() / adminSetDisabled()
}
class Session <<in memory>> {
  user : UserAccount
  endedReason
  lastWallet, lastWalletAt
  offline : bool
  +start(user) / end(reason)
  +walletConfirmed(wallet)
}
class UserAccount {
  id, email, role
}

CurrencyApp --> Session : listens
CurrencyApp --> LoginScreen
CurrencyApp --> HomeScreen
HomeScreen --> RatesScreen
HomeScreen --> WalletScreen
HomeScreen --> AccountScreen
HomeScreen --> AdminScreen
RatesScreen --> OrderScreen
LoginScreen --> ApiClient
RatesScreen --> ApiClient
WalletScreen --> ApiClient
OrderScreen --> ApiClient
AccountScreen --> ApiClient
AdminScreen --> ApiClient
ApiClient --> Session : no answer = offline\n401 / ACCOUNT_DISABLED = end
Session o-- UserAccount
note bottom of Session
  Planned in M1 but not built yet:
  LocalCache (on disk), ConnectivityMonitor,
  PendingOrders. The token lives in memory only.
end note
@enduml
