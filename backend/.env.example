# Copy this file to backend/.env and fill in your own values.
# backend/.env is listed in .gitignore and must never be committed.

# Random key that signs login tokens (at least 32 characters). Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite file, relative to backend/. The file is ignored by Git.
DATABASE_PATH=data/exchange.db

# How long a login token is valid, in seconds (24 h).
TOKEN_TTL_SECONDS=86400

# Starting wallet for new users.
START_BALANCE_PLN=1000.00

# Password for the demo user that seed.py creates (demo@example.com).
DEMO_PASSWORD=change-me-demo-password
